# Copy this file to .env.local and fill in your keys.

# ─── LLM provider (chat) ───
# One of: "google" (default, free tier) | "anthropic" | "openai"
LLM_PROVIDER=google

# Google Gemini — required for chat (default) AND embeddings (default)
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides:
# GOOGLE_MODEL=gemini-2.0-flash
# EMBEDDING_MODEL=text-embedding-004

# ─── Embedding provider ───
# One of:
#   "ollama"     — local, free, GPU-accelerated (development on your own GPU)
#   "cloudflare" — free tier @cf/baai/bge-base-en-v1.5, 768 dims (production)
#   "google"     — Gemini text embedding
#   "openai"     — OpenAI text-embedding-3-small (1536 dims)
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMS=768
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Cloudflare Workers AI (set EMBEDDING_PROVIDER=cloudflare to use)
# Token needs Account → Workers AI permission scope.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Anthropic — only required if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — only required if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ─── Supabase (pgvector store) ───
SUPABASE_URL=
# Use the SERVICE ROLE key for ingestion. The chat route uses it server-side too.
SUPABASE_SERVICE_ROLE_KEY=
# Anonymous key (optional fallback for read-only retrieval).
# SUPABASE_ANON_KEY=
